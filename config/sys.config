[
  {load_balancer, [
    %% HTTP Gateway Port that frontend connects to
    {listen_port, 8080},

    %% Rate limit: 10 requests per 1 minute (1 request every 6,000 milliseconds)
    {rate_per_minute, 10},

    %% Multi-Backend endpoints: Multiple Xano and Cloud servers
    {backends, [
      {xano_prod_1,   xano,  "https://x8ki-letl-twmt.xano.io/api:v1"},
      {xano_prod_2,   xano,  "https://x8ki-letl-twmt.xano.io/api:v2"},
      {cloud_server_1, cloud, "https://api.my-cloud-service.com"},
      {cloud_server_2, cloud, "https://api-backup.my-cloud-service.com"}
    ]}
  ]}
].

